<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sbe:messageSchema xmlns:sbe="http://fix.simple-binary-encoding.org/sbe/4.0"
                   package="com.kai.matchengine.sbe.outbound"
                   id="102"
                   version="1"
                   semanticVersion="1.0.0"
                   description="Match engine Kafka outbound"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <enum name="Side" encodingType="uint8">
            <validValue name="BID">0</validValue>
            <validValue name="ASK">1</validValue>
        </enum>
        <enum name="OrderUpdateType" encodingType="uint8">
            <validValue name="RESTING">0</validValue>
            <validValue name="PARTIALLY_FILLED">1</validValue>
            <validValue name="FILLED">2</validValue>
            <validValue name="CANCELLED">3</validValue>
            <validValue name="CANCELLED_REMAINDER">4</validValue>
        </enum>
        <enum name="RejectReason" encodingType="uint8">
            <validValue name="INVALID_QTY">0</validValue>
            <validValue name="INVALID_PRICE">1</validValue>
            <validValue name="DUPLICATE_ORDER_ID">2</validValue>
            <validValue name="ORDER_NOT_FOUND">3</validValue>
            <validValue name="USER_MISMATCH">4</validValue>
            <validValue name="UNKNOWN_SYMBOL">5</validValue>
            <validValue name="SYMBOL_NOT_TRADABLE">6</validValue>
            <validValue name="SYMBOL_ALREADY_EXISTS">7</validValue>
            <validValue name="INVALID_SYMBOL_CODE">8</validValue>
            <validValue name="SYMBOL_HAS_ORDERS">9</validValue>
            <validValue name="SYMBOL_CODE_IMMUTABLE">10</validValue>
            <validValue name="BOOK_FULL">11</validValue>
        </enum>
        <enum name="InboundEventType" encodingType="uint8">
            <validValue name="PLACE_ORDER">0</validValue>
            <validValue name="CANCEL_ORDER">1</validValue>
            <validValue name="CREATE_SYMBOL">2</validValue>
            <validValue name="HALT_SYMBOL">3</validValue>
            <validValue name="RESUME_SYMBOL">4</validValue>
            <validValue name="UPDATE_SYMBOL">5</validValue>
        </enum>
        <enum name="SymbolStatus" encodingType="uint8">
            <validValue name="TRADING">0</validValue>
            <validValue name="HALTED">1</validValue>
        </enum>
        <type name="SymbolCode" primitiveType="char" length="16" characterEncoding="UTF-8"/>
    </types>

    <sbe:message name="Trade" id="1" description="Trade event">
        <field name="symbolId" id="1" type="int32"/>
        <field name="eventId" id="2" type="int64"/>
        <field name="eventTime" id="3" type="int64"/>
        <field name="takerOrderId" id="4" type="int64"/>
        <field name="takerUserId" id="5" type="int64"/>
        <field name="makerOrderId" id="6" type="int64"/>
        <field name="makerUserId" id="7" type="int64"/>
        <field name="priceTick" id="8" type="int64"/>
        <field name="qty" id="9" type="int64"/>
        <field name="takerSide" id="10" type="Side"/>
    </sbe:message>

    <sbe:message name="OrderUpdate" id="2" description="Order update event">
        <field name="symbolId" id="1" type="int32"/>
        <field name="eventId" id="2" type="int64"/>
        <field name="eventTime" id="3" type="int64"/>
        <field name="orderId" id="4" type="int64"/>
        <field name="userId" id="5" type="int64"/>
        <field name="side" id="6" type="Side"/>
        <field name="priceTick" id="7" type="int64"/>
        <field name="remainingQty" id="8" type="int64"/>
        <field name="filledDelta" id="9" type="int64"/>
        <field name="updateType" id="10" type="OrderUpdateType"/>
    </sbe:message>

    <sbe:message name="BookUpdate" id="3" description="Book level update">
        <field name="symbolId" id="1" type="int32"/>
        <field name="bookVersion" id="2" type="int64"/>
        <field name="eventTime" id="3" type="int64"/>
        <field name="side" id="4" type="Side"/>
        <field name="priceTick" id="5" type="int64"/>
        <field name="levelQty" id="6" type="int64"/>
    </sbe:message>

    <sbe:message name="CommandResultPlace" id="4" description="Place command result">
        <field name="symbolId" id="1" type="int32"/>
        <field name="clientRequestId" id="2" type="int64"/>
        <field name="accepted" id="3" type="uint8"/>
        <field name="rejectReason" id="4" type="RejectReason" presence="optional"/>
        <field name="eventTime" id="5" type="int64"/>
        <field name="orderId" id="6" type="int64"/>
        <field name="filledQty" id="7" type="int64"/>
        <field name="remainingQty" id="8" type="int64"/>
        <field name="resting" id="9" type="uint8"/>
    </sbe:message>

    <sbe:message name="CommandResultCancel" id="5" description="Cancel command result">
        <field name="symbolId" id="1" type="int32"/>
        <field name="clientRequestId" id="2" type="int64"/>
        <field name="accepted" id="3" type="uint8"/>
        <field name="rejectReason" id="4" type="RejectReason" presence="optional"/>
        <field name="eventTime" id="5" type="int64"/>
        <field name="orderId" id="6" type="int64"/>
    </sbe:message>

    <sbe:message name="CommandResultSymbol" id="6" description="Symbol lifecycle command result">
        <field name="symbolId" id="1" type="int32"/>
        <field name="clientRequestId" id="2" type="int64"/>
        <field name="accepted" id="3" type="uint8"/>
        <field name="rejectReason" id="4" type="RejectReason" presence="optional"/>
        <field name="eventTime" id="5" type="int64"/>
        <field name="eventType" id="6" type="InboundEventType"/>
        <field name="status" id="7" type="SymbolStatus" presence="optional"/>
        <field name="code" id="8" type="SymbolCode"/>
    </sbe:message>

    <sbe:message name="BookSnapshot" id="7" description="Full book snapshot event">
        <field name="symbolId" id="1" type="int32"/>
        <field name="bookVersion" id="2" type="int64"/>
        <field name="eventTime" id="3" type="int64"/>
    </sbe:message>
</sbe:messageSchema>
